# ── Provider — choose ONE ────────────────────────────────────────────────────
# Option A: Anthropic / Claude (paid, best quality)
HERMES_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option B: OpenRouter (free tier available — comment out Option A and use this)
# Sign up free at https://openrouter.ai → Dashboard → Keys → Create Key
# HERMES_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
# Other good free models (128K context):
#   google/gemma-3-12b-it:free
#   microsoft/phi-3-mini-128k-instruct:free
#   meta-llama/llama-3.2-3b-instruct:free

# ── Telegram gateway ─────────────────────────────────────────────────────────
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your Telegram user ID — locks the bot so only YOU can use it.
# How to find it: message @userinfobot on Telegram; it replies with your ID.
# Comma-separated for multiple users, e.g. "123456789,987654321"
TELEGRAM_ALLOWED_USERS=your-telegram-user-id-here

# ── Voice transcription (optional) ───────────────────────────────────────────
# Enables /voice memo support via OpenAI Whisper API.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Web search tool (optional) ───────────────────────────────────────────────
# Enables the web_search tool (Exa AI).
# Get a free key at https://exa.ai
EXA_API_KEY=

# ── Web scraping tool (optional) ─────────────────────────────────────────────
# Enables the scrape_url tool (Firecrawl).
# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── Model config (optional) ──────────────────────────────────────────────────
HERMES_MODEL=claude-sonnet-4-6
HERMES_MAX_TOKENS=2048

# ── API server config (optional) ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
PORT=8000

# ── Email channel (optional) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
