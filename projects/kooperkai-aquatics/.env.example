# Kooperkai Aquatics - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google Sheets Integration
# Get these from your Google Cloud Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Google Sheet ID
# Get this from your Google Sheet URL: https://docs.google.com/spreadsheets/d/{THIS_IS_THE_ID}/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Payment Integration (Optional for local dev)
PAYPAL_CLIENT_ID=your-paypal-client-id
SQUARE_MERCHANT_ID=your-square-merchant-id

# Environment
NODE_ENV=development
