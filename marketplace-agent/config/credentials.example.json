{
  "_comment": "Copy this file to credentials.json and fill in your API keys. credentials.json is gitignored for security.",

  "email": {
    "email": "your-email@gmail.com",
    "password": "your-app-specific-password",
    "smtp_server": "smtp.gmail.com",
    "smtp_port": 587,
    "imap_server": "imap.gmail.com",
    "imap_port": 993,
    "_notes": {
      "gmail": "Use app-specific password from https://myaccount.google.com/apppasswords",
      "outlook": "smtp: smtp-mail.outlook.com, imap: outlook.office365.com",
      "yahoo": "smtp: smtp.mail.yahoo.com, imap: imap.mail.yahoo.com"
    }
  },

  "sms": {
    "account_sid": "your-twilio-account-sid",
    "auth_token": "your-twilio-auth-token",
    "phone_number": "+11234567890",
    "_notes": {
      "setup": "Get credentials from https://www.twilio.com/console",
      "cost": "Twilio charges ~$1/mo for phone + $0.0075 per SMS",
      "install": "pip install twilio"
    }
  },

  "voice": {
    "account_sid": "your-twilio-account-sid",
    "auth_token": "your-twilio-auth-token",
    "phone_number": "+11234567890",
    "voice": "Polly.Joanna",
    "_notes": {
      "voice_options": "Polly.Joanna, Polly.Matthew, Polly.Amy, etc.",
      "cost": "Twilio charges ~$0.013 per minute for calls"
    }
  },

  "marketplaces": {
    "facebook": {
      "access_token": "optional-facebook-access-token",
      "page_id": "optional-page-id",
