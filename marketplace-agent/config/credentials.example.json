      }
    },
    "offerup": {
      "email": "your-offerup-email@example.com",
      "_notes": "OfferUp requires mobile app. This generates posting guides."
    }
  },

  "payment": {
    "paypal_email": "your-paypal@example.com",
    "venmo_username": "your-venmo-username",
    "cash_enabled": true,
    "_notes": {
      "paypal": "Standard PayPal account. No API needed for basic payment requests.",
      "venmo": "Personal Venmo account. Username without @ symbol.",
      "cash": "For local pickup transactions"
