# This is an example of environment variables for local development
# Copy this to .env.local and fill in your actual values

# Database - Use a local PostgreSQL or a service like Supabase/Neon
DATABASE_URL="postgresql://postgres:password@localhost:5432/situation_planner"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth - Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Provider - Choose "claude" or "openai"
AI_PROVIDER="claude"

# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI API Key - Get from https://platform.openai.com/
OPENAI_API_KEY="sk-..."
