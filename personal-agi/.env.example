# AI Models
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/personal_agi
REDIS_URL=redis://localhost:6379

# GCP (if deploying to Google Cloud)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Communication
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
USER_PHONE_NUMBER=your_phone_number

# Security
ENCRYPTION_KEY=generate_a_random_32_char_key_here
JWT_SECRET=generate_a_random_jwt_secret_here
NFC_VERIFICATION_SECRET=generate_a_random_secret_here

# Server
PORT=3000
NODE_ENV=development

# Features
ENABLE_SMS_VERIFICATION=true
ENABLE_NFC_VERIFICATION=false
DEFAULT_MODEL=claude
