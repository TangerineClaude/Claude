# Database
DATABASE_URL=postgresql://localhost:5432/agent_control

# AI Provider (choose one)

# Option 1: Google Gemini (Recommended - Free tier available!)
GEMINI_API_KEY=your_gemini_api_key_here
# Get your key: https://makersuite.google.com/app/apikey
# Models: gemini-pro, gemini-1.5-pro, gemini-1.5-flash

# Option 2: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Replit AI integrations
# AI_INTEGRATIONS_OPENAI_API_KEY=your_replit_ai_key_here
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://ai-integrations.replit.com/v1

# Server
PORT=3000
NODE_ENV=development
