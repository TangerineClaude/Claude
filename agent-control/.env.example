# Database
DATABASE_URL=postgresql://localhost:5432/agent_control

# OpenAI API (use one of these)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Or use Replit AI integrations
AI_INTEGRATIONS_OPENAI_API_KEY=your_replit_ai_key_here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://ai-integrations.replit.com/v1

# Server
PORT=3000
NODE_ENV=development
