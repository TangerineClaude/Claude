{
  "name": "agent-control",
  "version": "1.0.0",
  "description": "AI Agent Swarm Control Center",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "prebuild": "node scripts/generate-icons.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --external:pg-native --external:playwright",
    "postbuild": "cp -r client/public/manifest.json client/public/sw.js client/public/*.svg dist/public/ 2>/dev/null || true",
    "start": "node dist/server/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy:railway": "railway up",
    "deploy:fly": "fly deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.19",
    "date-fns": "^3.2.0",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "framer-motion": "^11.0.3",
    "pg": "^8.11.3",
    "playwright": "^1.41.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wouter": "^3.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.20.10",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
